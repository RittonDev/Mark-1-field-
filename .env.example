# Copie para .env (o docker compose lê automaticamente). Nunca commite o .env.

# Segredo dos tokens JWT. Em produção: >= 32 caracteres aleatórios (ex.: openssl rand -hex 32).
JWT_SECRET=dev-only-secret-troque-em-producao

# Origens liberadas no CORS da API (separadas por vírgula).
CORS_ORIGINS=http://localhost:3001

# Senha dos usuários de exemplo criados por `python -m app.seed` (só desenvolvimento).
# Senha dos usuários de exemplo do seed (mínimo 8 caracteres). Defina a sua no .env;
# nunca publique o valor real (este repositório é público).
SEED_PASSWORD=

# URLs que o navegador usa para falar com a API (embutidas no build do frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Mapa ao vivo: provedor de mapas. Vazio = OpenStreetMap (sem chave, uso moderado).
# Em produção use um provedor contratado, ex.: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_DARK_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
