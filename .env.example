# Copie para .env (o docker compose lê automaticamente). Nunca commite o .env.

# Segredo dos tokens JWT. Em produção: >= 32 caracteres aleatórios (ex.: openssl rand -hex 32).
JWT_SECRET=dev-only-secret-troque-em-producao

# Origens liberadas no CORS da API (separadas por vírgula).
CORS_ORIGINS=http://localhost:3001

# Senha dos usuários de exemplo do seed (`python -m app.seed`, só desenvolvimento) (mínimo 8 caracteres). Defina a sua no .env;
# nunca publique o valor real (este repositório é público).
SEED_PASSWORD=

# URLs que o navegador usa para falar com a API (embutidas no build do frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Endereço público do site: links de cadastro de técnico e volta do login Microsoft.
WEB_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=

# Login Microsoft (Entra ID) para analistas e gestores. Para ativar, registre o app em
# entra.microsoft.com > Identidade > Aplicativos > Registros de aplicativo > Novo registro:
#   - Tipos de conta: "Somente contas deste diretório organizacional" (locatário único)
#   - URI de redirecionamento (plataforma Web): ENTRA_REDIRECT_URI abaixo
#   - Certificados e segredos > Novo segredo do cliente (copie o VALOR, não o ID)
# Preencha os três primeiros com o ID do diretório (locatário), o ID do aplicativo e o segredo.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
ENTRA_ALLOWED_DOMAINS=maxxgroup.com.br
# true: analistas e gestores desses domínios só entram pela Microsoft (sem senha local).
ENTRA_ENFORCE_FOR_STAFF=false
# Vazio: só entra quem já está em Usuários. "analyst": o primeiro login cria como analista.
ENTRA_AUTO_PROVISION_ROLE=

# Mapa ao vivo: provedor de mapas. Vazio = OpenStreetMap (sem chave, uso moderado).
# Em produção use um provedor contratado, ex.: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_DARK_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
