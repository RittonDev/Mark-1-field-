# Gateway da homologação do MaxxChamados. O nginx oficial troca ${TECNICO_HOST} e ${CENTRAL_HOST} no start.
#
#   ${TECNICO_HOST}  -> app dos técnicos (PWA, arquivos estáticos) e /api -> API
#   ${CENTRAL_HOST}  -> central (Next.js) e /api -> API
#
# O proxy do Coolify termina o HTTPS e repassa para a porta 80 deste container.

# Nomes da rede interna resolvidos a cada pedido (o DNS do Docker): API ou central reiniciada não derruba o gateway.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Atrás do proxy do Coolify o https chega no X-Forwarded-Proto; num teste local, vale o esquema da conexão.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server_tokens off;
client_max_body_size 20m;

gzip on;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json application/manifest+json application/wasm image/svg+xml;

# ---------------------------------------------------------------------------------------------------- app dos técnicos
server {
    listen 80 default_server;
    server_name ${TECNICO_HOST};
    root /usr/share/nginx/pwa;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $api http://api:8000;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # O SQLite do app roda em WebAssembly com SharedArrayBuffer: a página precisa ficar isolada
    # (COOP same-origin + COEP require-corp; o Safari do iPhone não aceita "credentialless"). Tudo o que o app
    # carrega vem desta mesma origem (pacote, fontes, wasm, fotos pela /api), então require-corp não bloqueia nada.
    # O add_header de uma location apaga os de cima: os cabeçalhos se repetem em cada uma.

    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        add_header Service-Worker-Allowed "/" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Arquivos com hash no nome (pacote JS, fontes, wasm do SQLite): cache longo.
    location ~* ^/(_expo|assets)/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # O app é uma página só: qualquer rota (/ticket/..., /configuracoes, ...) abre o index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}

# ---------------------------------------------------------------------------------------------------- central
server {
    listen 80;
    server_name ${CENTRAL_HOST};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $api http://api:8000;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        set $central http://web:3001;
        proxy_pass $central;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
